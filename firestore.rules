rules_version = '2';

// Security model
// ---------------
// - cities / rates / news: publicly readable (the whole point of the app
//   is that anyone can see rates without logging in). Writable only by a
//   signed-in user whose phone number is on the `admins` allow-list.
// - admins: readable by any signed-in user (needed for the app to check
//   "is this phone number an admin" right after OTP verification).
//   Writable only from the Firebase console / Admin SDK — never from the
//   client — so a compromised device can never grant itself admin rights.
// - users: each visitor may create/update only their own document; the
//   whole collection is readable by any admin (checked via the allow-list)
//   so the admin "Users" screen can list everyone.
// - appConfig: two fixed docs (`onboarding`, `version`) read by every
//   client on startup — see fetchOnboardingContent/fetchVersionConfig in
//   firestore_service.dart. Public read like cities/rates/news. `version`
//   in particular is meant to be hand-edited by the developer from the
//   Firebase console (see AppVersionConfig's doc comment) rather than from
//   an admin UI, but console/Admin SDK writes aren't subject to these
//   rules anyway — allow-listing isAdmin() here just also lets it be
//   managed from the app later without a rules change.

function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn()
    && request.auth.token.phone_number != null
    && exists(/databases/$(database)/documents/admins/$(request.auth.token.phone_number));
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rates/{rateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One doc per city+category holding just the latest price — kept in
    // sync by the syncCurrentRateOnWrite Cloud Function whenever a `rates`
    // doc is created/edited/deleted. This exists purely so "what's the
    // current rate" queries don't have to scan the entire (ever-growing)
    // `rates` history — see functions/index.js for why. Never written to
    // directly by clients.
    match /currentRates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{phoneNumber} {
      allow read: if isSignedIn();
      allow write: if false; // manage from the Firebase console only
    }

    match /users/{uid} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
